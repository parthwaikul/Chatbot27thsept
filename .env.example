GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=300

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

CHROMA_DIR=./chroma
CHROMA_COLLECTION=mf_faq

CORPUS_DIR=./corpus
SOURCES_YAML=./config/sources.yaml
SOURCES_CSV=./corpus/sources.csv
CHUNKS_TXT=./chunks.txt
CHUNKS_JSONL=./chunks.jsonl
SOURCES_MD=./SOURCES.md
SAMPLE_QA=./SAMPLE_QA.md
LOGS_DIR=./logs

# Chunking: decided in CHUNKING.md section 2. src/ingest/chunker.py reads these
# three, so the documented values and the used values cannot drift.
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CHUNK_STRATEGY=section_atomic_recursive

# Retrieval: decided in Phase 3, appended to CHUNKING.md under "Retrieval tuning".
RETRIEVAL_TOP_K=3
SIMILARITY_FLOOR=0.30

ANSWER_MAX_SENTENCES=3

EDUCATIONAL_LINK=https://investor.sebi.gov.in/
FACTSHEET_LINK_MAP=

APP_ENV=local
HTTP_TIMEOUT_S=20
HTTP_USER_AGENT=mf-faq-rag/0.1 (educational prototype; +local)
MIN_EXTRACTED_CHARS=500
